<?xml version="1.0" encoding="UTF-8"?>
<!-- WiX v5 MSI Installer Definition for DevBench Windows Desktop -->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
    Name="DevBench"
    Manufacturer="DevBench Contributors"
    Version="1.1.0.0"
    UpgradeCode="4B91C6D8-7E4A-4B28-91E0-8A54C3D91F02"
    Scope="perUserOrMachine">

    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="DevBenchIcon.ico" SourceFile="..\DevBench.ico" />
    <Property Id="ARPPRODUCTICON" Value="DevBenchIcon.ico" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="INSTALLFOLDER" Name="DevBench">
        <Component Id="MainApplication" Guid="7E51C1F2-32B4-4F90-8E11-45A88F1029AA">
          <File Id="DevBenchExe" Source="..\..\release\win-unpacked\DevBench.exe" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut" Guid="A321F8C4-54A1-41D8-BC8E-90D12E5B7421">
        <Shortcut
          Id="ApplicationStartMenuShortcut"
          Name="DevBench"
          Description="Modular Windows Software Development Toolkit"
          Target="[INSTALLFOLDER]DevBench.exe"
          WorkingDirectory="INSTALLFOLDER" />
        <RemoveFolder Id="CleanUpShortCut" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\DevBench" Name="installed" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <Feature Id="MainFeature" Title="DevBench Desktop Workbench" Level="1">
      <ComponentRef Id="MainApplication" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>
  </Package>
</Wix>
