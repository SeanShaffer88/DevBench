#include <winres.h>

IDI_APP_ICON ICON "DevBench.ico"
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "DevBench.app.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,5,0,0
 PRODUCTVERSION 1,5,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "DevBench Contributors"
            VALUE "FileDescription", "DevBench — Modular Windows Software Development Toolkit"
            VALUE "FileVersion", "1.5.0.0"
            VALUE "ProductName", "DevBench"
            VALUE "ProductVersion", "1.5.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END