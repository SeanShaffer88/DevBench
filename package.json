{
  "name": "devbench",
  "version": "1.1.0",
  "private": true,
  "description": "DevBench — Modular Windows Software Development Toolkit & Desktop Engineering Workbench",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k -n api,web \"tsx watch server/index.ts\" \"vite --host 0.0.0.0 --port 5173\"",
    "dev:api": "tsx server/index.ts",
    "dev:web": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc --noEmit && vite build",
    "preview": "concurrently -k -n api,web \"tsx server/index.ts\" \"vite preview --host 0.0.0.0 --port 4173\"",
    "test": "vitest run",
    "gen:win-icon": "tsx scripts/generate-win-icon.mjs",
    "desktop": "node electron/launch.mjs",
    "dist:win": "npm run gen:win-icon && npx electron-builder --win --config electron-builder.yml"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  }
}
